# ==================================================
# FitiGo (local development)
# ==================================================

APP_NAME=FitiGo
ENVIRONMENT=development
# HTTP traceback pages are disabled regardless of this diagnostic setting.
DEBUG=false

# MySQL (SQLAlchemy URL)
# Example:
# mysql+pymysql://fitigo_user:fitigo_password@localhost:3306/fitigo
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/fitigo

# JWT
JWT_SECRET=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Uploads
UPLOAD_DIR=uploads

# CORS
ALLOWED_ORIGINS=http://localhost:5173

# Payment provider: backend only. Explicit selection enables verified checkout.
# Startup fails until selected-provider credentials below are supplied.
PAYMENT_GATEWAY=razorpay
PAYMENT_ENV=sandbox
# Return to the existing checkout/recent-payments page; HTTPS in production.
PAYMENT_RETURN_URL=http://localhost:5173/checkout
# Legacy only: when PAYMENT_GATEWAY is omitted, RAZORPAY_ENABLED controls enablement.
# PAYMENT_MODE=test|live is supported if PAYMENT_ENV is omitted. Do not set conflicting modes.
# RAZORPAY_ENABLED=false
# PAYMENT_MODE=test

# Razorpay: use keys matching sandbox (rzp_test_) or production (rzp_live_).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Live additionally requires ENVIRONMENT=production and explicit opt-in.
RAZORPAY_LIVE_ENABLED=false


# Cashfree: use the matching environment's PG API keys, never frontend VITE_ values.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2026-01-01