# ==================================================
# FitiGo (local development)
# ==================================================

APP_NAME=FitiGo
ENVIRONMENT=development
DEBUG=true

# MySQL (SQLAlchemy URL)
# Example:
# mysql+pymysql://fitigo_user:fitigo_password@localhost:3306/fitigo
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/fitigo

# JWT
JWT_SECRET=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Uploads
UPLOAD_DIR=uploads

# CORS
ALLOWED_ORIGINS=http://localhost:5173

# Razorpay: backend only. Test mode is the default; never use VITE_ secrets.
RAZORPAY_ENABLED=false
PAYMENT_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Live additionally requires ENVIRONMENT=production and explicit opt-in.
RAZORPAY_LIVE_ENABLED=false


# Cashfree
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2026-01-01