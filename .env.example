# ==================================================
# FitiGo (local development)
# ==================================================

APP_NAME=FitiGo
ENVIRONMENT=development
# HTTP traceback pages are disabled regardless of this diagnostic setting.
DEBUG=false

# MySQL (SQLAlchemy URL)
# Example:
# mysql+pymysql://fitigo_user:fitigo_password@localhost:3306/fitigo
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/fitigo

# JWT: required for API startup in ALL environments. No shared default.
# Supply a cryptographically random, private value (e.g. secrets.token_urlsafe(64)).
# Keep it stable and identical across workers; never put it in VITE_ variables.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Uploads
UPLOAD_DIR=uploads

# CORS
ALLOWED_ORIGINS=http://localhost:5173

# Payment provider: backend only. Explicit selection enables verified checkout.
# Startup fails until selected-provider credentials below are supplied.
PAYMENT_GATEWAY=razorpay
PAYMENT_ENV=sandbox
# Return to the existing checkout/recent-payments page; HTTPS in production.
PAYMENT_RETURN_URL=http://localhost:5173/checkout
# Legacy only: when PAYMENT_GATEWAY is omitted, RAZORPAY_ENABLED controls enablement.
# PAYMENT_MODE=test|live is supported if PAYMENT_ENV is omitted. Do not set conflicting modes.
# RAZORPAY_ENABLED=false
# PAYMENT_MODE=test

# Razorpay: use keys matching sandbox (rzp_test_) or production (rzp_live_).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Live additionally requires ENVIRONMENT=production and explicit opt-in.
RAZORPAY_LIVE_ENABLED=false


# Cashfree: use the matching environment's PG API keys, never frontend VITE_ values.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2026-01-01

# Account onboarding/recovery delivery. Server-only; never VITE_ variables.
# Choose smtp only after configuring a real provider. No console/test delivery mode.
EMAIL_PROVIDER=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Set your actual public HTTPS origin in production. Local HTTP is allowed only
# with ENVIRONMENT=development and a loopback hostname.
PUBLIC_FRONTEND_URL=http://localhost:5173
# Optional legacy override. Leave blank to use PUBLIC_FRONTEND_URL/auth/reset-password.
PASSWORD_RESET_FRONTEND_URL=
PASSWORD_RESET_EXPIRY_MINUTES=30
INVITATION_EXPIRY_HOURS=48
INVITATION_RESEND_SECONDS=60
OTP_EXPIRY_SECONDS=600
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_SEND_LIMIT=5
# Optional SMS. Twilio Messages API; provider/country sender approval is required.
SMS_PROVIDER=disabled
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Enable only after operational audit/photo cleanup migration df081ac34602.
OPERATIONAL_WORKFLOWS_ENABLED=false

# Apply ef192bd45713 before enabling. Email worker is a separate explicit opt-in.
NOTIFICATION_WORKFLOWS_ENABLED=false
NOTIFICATION_EMAIL_ENABLED=false
SUPPORT_EMAIL=

# Private in-app support; apply f02a3ce56824 and enable operational audit first.
SUPPORT_WORKFLOWS_ENABLED=false
